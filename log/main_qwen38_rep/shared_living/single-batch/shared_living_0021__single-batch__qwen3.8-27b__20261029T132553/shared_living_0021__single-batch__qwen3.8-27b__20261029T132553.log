60,3,1,talk,Asuka,,"Option A is the Mountain Centre. Public, fixed rate, but strict lottery.","{""words"":12,""mentions"":[],""raw_differs"":false}"
61,3,1,talk,Shion,,"Option B is the Campus. We have the hall, but the canteen is closed.","{""words"":14,""mentions"":[],""raw_differs"":false}"
62,3,1,talk,Minato,,"Option C is the Coastal Lodge. Whole building, but non-refundable deposits.","{""words"":11,""mentions"":[],""raw_differs"":false}"
63,3,1,talk,Misaki,,"Option A has the clearest costs. 1,100 yen per bed. No hidden fees.","{""words"":13,""mentions"":[],""raw_differs"":false}"
64,3,1,talk,Takumi,,Option A has shared dorms. That forces the year groups to mix in the evenings.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
65,3,2,talk,Asuka,,"@Misaki, I agree. The fixed rate is best for the budget.","{""words"":11,""mentions"":[""Misaki""],""raw_differs"":false}"
66,3,2,talk,Shion,,"@Takumi, shared dorms are good for mixing, but eight to a room is tight.","{""words"":14,""mentions"":[""Takumi""],""raw_differs"":false}"
67,3,2,talk,Minato,,"@Shion, if we go to A, we don't have to cook. That saves time.","{""words"":14,""mentions"":[""Shion""],""raw_differs"":false}"
68,3,2,talk,Misaki,,"@Asuka, yes. The transport cost is high, but the bed cost is low.","{""words"":13,""mentions"":[""Asuka""],""raw_differs"":false}"
69,3,2,talk,Takumi,,"@Minato, I think A is the best for the club's social side.","{""words"":12,""mentions"":[""Minato""],""raw_differs"":false}"
70,3,3,talk,Asuka,,The non-refundable deposit for C is a risk. I prefer A.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
71,3,3,talk,Shion,,"The lottery for A is a risk, but the conditions are better than B.","{""words"":14,""mentions"":[],""raw_differs"":false}"
72,3,3,talk,Minato,,"I am happy with A. No cooking, and the cost is clear.","{""words"":12,""mentions"":[],""raw_differs"":false}"
73,3,3,talk,Misaki,,I vote for A. The budget is manageable.,"{""words"":8,""mentions"":[],""raw_differs"":false}"
74,3,3,talk,Takumi,,I vote for A. It brings everyone together.,"{""words"":8,""mentions"":[],""raw_differs"":false}"
