33,1,1,talk,Victoria,,"Minako, you claim to be the Seer? That is a bold start.","{""words"":12,""mentions"":[""Minako""],""raw_differs"":false}"
34,1,1,talk,Takumi,,"Wait, what? Minako says I'm human? I knew I was!","{""words"":10,""mentions"":[""Minako""],""raw_differs"":false}"
35,1,1,talk,Misaki,,"Interesting. Minako, why did you choose Takumi first? What was your logic?","{""words"":12,""mentions"":[""Minako"",""Takumi""],""raw_differs"":false}"
36,1,2,talk,Sakura,,"Minako, you're the Seer? Cool! So who else did you check?","{""words"":11,""mentions"":[""Minako""],""raw_differs"":false}"
