34,2,,status,Shizue,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
35,2,1,talk,Shizue,,"The lab is drowning. Two hundred pieces wait, and we have only one person to save them.","{""words"":17,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Shion,,"@Shizue, that is a staffing problem. I found the real killer is the paperwork.","{""words"":14,""mentions"":[""Shizue""],""raw_differs"":false}"
37,2,1,talk,May,,"@Shion, I found something else. People don't come back for the objects. They come back for the people.","{""words"":18,""mentions"":[""Shion""],""raw_differs"":false}"
38,2,1,talk,Misaki,,"@Shion, the paperwork is a symptom. The building is the body. It is tired.","{""words"":14,""mentions"":[""Shion""],""raw_differs"":false}"
39,2,1,talk,Sakura,,"@Shion, I found the money. It is not in the art. It is in the boxes.","{""words"":16,""mentions"":[""Shion""],""raw_differs"":false}"
40,2,2,talk,Shizue,,"@Sakura, if the boxes cost more than the art, we are buying a headache.","{""words"":14,""mentions"":[""Sakura""],""raw_differs"":false}"
41,2,2,talk,Shion,,"@Sakura, exactly. The boxes are where the season dies. I saw the dates slip.","{""words"":14,""mentions"":[""Sakura""],""raw_differs"":false}"
42,2,2,talk,May,,"@Shizue, the lab is full, but the people are empty. We need to fill the room with life.","{""words"":18,""mentions"":[""Shizue""],""raw_differs"":false}"
43,2,2,talk,Misaki,,"@Shizue, the lab is full because the displays break. I saw the logs.","{""words"":13,""mentions"":[""Shizue""],""raw_differs"":false}"
44,2,2,talk,Sakura,,"@Shion, the boxes are the tax. I want to pay less tax.","{""words"":12,""mentions"":[""Shion""],""raw_differs"":false}"
45,2,3,talk,Shizue,,We cannot ask one person to save two hundred pieces. We need a show that needs less saving.,"{""words"":18,""mentions"":[],""raw_differs"":false}"
46,2,3,talk,Shion,,"@Shizue, I agree. A show that arrives on time is a show that needs less saving.","{""words"":16,""mentions"":[""Shizue""],""raw_differs"":false}"
47,2,3,talk,May,,"@Shizue, a show that needs less saving is a show that needs more talking.","{""words"":14,""mentions"":[""Shizue""],""raw_differs"":false}"
48,2,3,talk,Misaki,,"@Shizue, a show that needs less saving is a show that does not break the floor.","{""words"":16,""mentions"":[""Shizue""],""raw_differs"":false}"
49,2,3,talk,Sakura,,"@Shizue, a show that needs less saving is a show that does not eat the budget.","{""words"":16,""mentions"":[""Shizue""],""raw_differs"":false}"
50,2,4,talk,Shizue,,"Let us choose a show that fits the hands we have, not the hands we wish we had.","{""words"":18,""mentions"":[],""raw_differs"":false}"
51,2,4,talk,Shion,,Let us choose a show that arrives when it says it will.,"{""words"":12,""mentions"":[],""raw_differs"":false}"
52,2,4,talk,May,,Let us choose a show that makes people want to stay and talk.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
53,2,4,talk,Misaki,,Let us choose a show that the floor can hold without a shoring crew.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
54,2,4,talk,Sakura,,Let us choose a show that does not hide its costs in the crates.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
