35,2,1,talk,Midori,,The joint clinic failed because neither department wanted the rota.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Jonathan,,"The call-back trial reduced readmissions, but it stopped working when it ended.","{""words"":12,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Misaki,,We have nine unfilled nursing posts and rising agency costs.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Shion,,"The budget is down a quarter, and off-site visits earn no tariff.","{""words"":12,""mentions"":[],""raw_differs"":false}"
