60,3,1,talk,Servas,,"Candidate A, the Microbiome Atlas, relies on field sites which are risky.","{""words"":12,""mentions"":[],""raw_differs"":false}"
61,3,1,talk,Sakura,,"Candidate B, Protein Folding, uses free computing but the spectroscopy suite is unstable.","{""words"":13,""mentions"":[],""raw_differs"":false}"
62,3,1,talk,Daisuke,,"Candidate C, Regeneration, involves live breeding which often overruns schedules.","{""words"":10,""mentions"":[],""raw_differs"":false}"
63,3,1,talk,Takumi,,"Candidate D, Plant Drought, uses the glasshouse which is fully booked but ready.","{""words"":13,""mentions"":[],""raw_differs"":false}"
64,3,1,talk,Minako,,Candidate D fits well with the available glasshouse crew and facilities.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
