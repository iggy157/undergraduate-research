71,3,3,talk,Victoria,,"It is a wayfinding project, not a room.","{""words"":8,""mentions"":[],""raw_differs"":false}"
72,3,3,talk,Benjamin,,Weather will delay it. Six weeks lost to rain.,"{""words"":9,""mentions"":[],""raw_differs"":false}"
73,3,3,talk,Kenji,,"Surfacing costs are stable, though.","{""words"":5,""mentions"":[],""raw_differs"":false}"
74,3,3,talk,Shunichi,,"It helps the grounds staff, but they are already unfilled.","{""words"":10,""mentions"":[],""raw_differs"":false}"
75,3,4,talk,Mizuki,,"Candidate D, the Lab Ventilation, helps the technicians.","{""words"":8,""mentions"":[],""raw_differs"":false}"
76,3,4,talk,Victoria,,"It is a single wing, so low post-occupancy rating.","{""words"":9,""mentions"":[],""raw_differs"":false}"
77,3,4,talk,Benjamin,,"It is an inspection fix, so it might be on time.","{""words"":11,""mentions"":[],""raw_differs"":false}"
78,3,4,talk,Kenji,,But mechanical costs are rising.,"{""words"":5,""mentions"":[],""raw_differs"":false}"
79,3,4,talk,Shunichi,,"Yes, it reduces their manual work.","{""words"":6,""mentions"":[],""raw_differs"":false}"
