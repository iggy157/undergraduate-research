0,1,,status,Victoria,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
1,1,,status,May,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
2,1,,status,Minato,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
3,1,,status,Shunichi,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
4,1,,status,Daisuke,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
5,1,1,talk,Victoria,,"Before we move furniture, I need to understand the financial baseline.","{""words"":11,""mentions"":[],""raw_differs"":false}"
6,1,1,talk,Minato,,I just want a spot that doesn't hurt my back by four o'clock.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
7,1,1,talk,May,,My calendar is already tight. I need to know the time cost of moving.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
8,1,1,talk,Shunichi,,Let's be honest about who gets the bad seats. It's never said out loud.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
9,1,1,talk,Daisuke,,I worry about who I'll sit next to. It changes how I talk to people.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
10,1,2,talk,Victoria,,"@Shunichi, fairness is good, but we can't afford to guess the costs.","{""words"":12,""mentions"":[""Shunichi""],""raw_differs"":false}"
11,1,2,talk,Minato,,"@May, if the move takes all day, I can't focus on my work.","{""words"":13,""mentions"":[""May""],""raw_differs"":false}"
12,1,2,talk,May,,"@Victoria, time is money too. I need to see the morning routine data.","{""words"":13,""mentions"":[""Victoria""],""raw_differs"":false}"
13,1,2,talk,Shunichi,,"@Daisuke, proximity matters, but we need a rule for it, not luck.","{""words"":12,""mentions"":[""Daisuke""],""raw_differs"":false}"
14,1,2,talk,Daisuke,,"@Minato, comfort is important, but so is connection. I feel isolated sometimes.","{""words"":12,""mentions"":[""Minato""],""raw_differs"":false}"
15,1,3,talk,Victoria,,I will look into the billing basis and the facilities quote.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
16,1,3,talk,Minato,,I want to check the sound levels and the physio notes.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
17,1,3,talk,May,,I'll look at the morning routine upstairs and the unplanned shuffles.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
18,1,3,talk,Shunichi,,I need to see the drawn plan and the arrival times.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
19,1,3,talk,Daisuke,,I want to know about the project strands and the new joiners.,"{""words"":12,""mentions"":[],""raw_differs"":false}"
20,1,4,talk,Victoria,,Agreed. Let's gather the facts before we decide.,"{""words"":8,""mentions"":[],""raw_differs"":false}"
21,1,4,talk,Minato,,Okay. I hope the sound isn't too loud near the door.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
22,1,4,talk,May,,I'm worried about the transition period. It always feels chaotic.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
23,1,4,talk,Shunichi,,We'll see what the data says. No more guessing.,"{""words"":9,""mentions"":[],""raw_differs"":false}"
24,1,4,talk,Daisuke,,I just want to feel part of the team again.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
