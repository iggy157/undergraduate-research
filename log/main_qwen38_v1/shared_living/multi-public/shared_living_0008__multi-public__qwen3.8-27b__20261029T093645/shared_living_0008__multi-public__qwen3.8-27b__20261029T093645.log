35,2,1,talk,May,,"The quotes are brutal. 141,000 for a meeting setup versus 96,000 for a kitchen. The meeting space is nearly fifty percent more expensive.","{""words"":23,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""name_label"",""name"":""May"",""self"":true,""raw"":""May: The quotes are brutal. 141,000 for a meeting setup versus 96,000 for a kitchen. The meeting space is nearly fifty percent more expensive.""}]}"
