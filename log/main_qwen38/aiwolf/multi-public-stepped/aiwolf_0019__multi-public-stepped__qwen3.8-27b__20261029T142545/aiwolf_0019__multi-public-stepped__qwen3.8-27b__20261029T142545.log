45,1,3,talk,Minako,,"@Mio If you are innocent, defend yourself. If not, you are done.","{""words"":12,""mentions"":[""Mio""],""raw_differs"":false}"
46,1,4,talk,Asuka,,@Mio Your denial is weak. I vote for you.,"{""words"":9,""mentions"":[""Mio""],""raw_differs"":false}"
47,1,4,talk,Takumi,,"@Mio I'm sorry, but I have to trust Shion for now.","{""words"":11,""mentions"":[""Mio"",""Shion""],""raw_differs"":false}"
