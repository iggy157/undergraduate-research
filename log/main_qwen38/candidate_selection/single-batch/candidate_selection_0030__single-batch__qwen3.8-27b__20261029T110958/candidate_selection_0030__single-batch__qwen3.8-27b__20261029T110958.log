35,2,1,talk,Minato,,"The coordination group is understaffed, and vendor queries are repetitive.","{""words"":10,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Jonathan,,"Network coverage is poor at half the sites, and developers are busy.","{""words"":12,""mentions"":[],""raw_differs"":false}"
