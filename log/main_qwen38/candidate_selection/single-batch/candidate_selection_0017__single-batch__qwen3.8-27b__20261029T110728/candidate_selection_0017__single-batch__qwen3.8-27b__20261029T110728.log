37,2,1,talk,Benjamin,,"The capital ledger has a ring-fenced balance, but operating subsidies are trimmed.","{""words"":12,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Servas,,"The previous accessibility programme had mixed results; some lifts finished, lanes didn't.","{""words"":12,""mentions"":[],""raw_differs"":false}"
39,2,1,talk,Jonathan,,"The pre-war shells have high contingency costs, and the operators never agreed on data terms.","{""words"":15,""mentions"":[],""raw_differs"":false}"
