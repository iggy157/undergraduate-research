31,2,,status,Asuka,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
32,2,,status,Rin,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
33,2,,status,Kenji,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
