42,2,2,talk,May,,"@Ryuji, a patchwork is just a system that quietly ages in place.","{""words"":12,""mentions"":[""Ryuji""],""raw_differs"":false}"
43,2,2,talk,Misaki,,"@May, a system that quietly ages in place is a system that quietly ages the people in it.","{""words"":18,""mentions"":[""May""],""raw_differs"":false}"
44,2,2,talk,Benjamin,,"@Misaki, a system that quietly ages the people in it is a system that quietly ages the budget in it.","{""words"":20,""mentions"":[""Misaki""],""raw_differs"":false}"
