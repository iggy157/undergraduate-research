35,2,1,talk,Shizue,,"The roads closed eleven times, but the halls kept their own timetables.","{""words"":12,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Jonathan,,The bus cuts mean the outer wards are effectively cut off from us.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Rin,,The old outreach sheets show forty people came when we actually went to them.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Benjamin,,"The grant pays for twelve months, then the flat budget takes the hit.","{""words"":13,""mentions"":[],""raw_differs"":false}"
39,2,1,talk,Minako,,"The volunteers are ready, but the staff have no training to supervise them.","{""words"":13,""mentions"":[],""raw_differs"":false}"
40,2,2,talk,Shizue,,"@Benjamin, if the grant ends, do we have a fallback for the equipment?","{""words"":13,""mentions"":[""Benjamin""],""raw_differs"":false}"
41,2,2,talk,Jonathan,,"@Minako, if the staff aren't trained, can we even use the volunteers?","{""words"":12,""mentions"":[""Minako""],""raw_differs"":false}"
