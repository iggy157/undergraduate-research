33,2,,status,Toshio,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
34,2,,status,Yumi,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
35,2,1,talk,Asuka,,"The call-back trial cut readmissions by a fifth, but only while it was actively running.","{""words"":15,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Toshio,,The booking system only tracks named slots. Anything unbooked vanishes from the records entirely.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Benjamin,,The last joint clinic died because neither department would own the rota or the budget.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Yumi,,"The therapy review shows four years of physiotherapists leaving for city posts, but midwifery has slack.","{""words"":16,""mentions"":[],""raw_differs"":false}"
39,2,1,talk,Servas,,"The ledger shows the development fund is down a quarter, and off-site contacts earn nothing from the fund.","{""words"":18,""mentions"":[],""raw_differs"":false}"
40,2,2,talk,Asuka,,"@Toshio, if unbooked work vanishes, how do we measure the value of a new program?","{""words"":15,""mentions"":[""Toshio""],""raw_differs"":false}"
41,2,2,talk,Toshio,,"@Asuka, we can't. The system is blind to anything that doesn't fit a fixed slot.","{""words"":15,""mentions"":[""Asuka""],""raw_differs"":false}"
42,2,2,talk,Benjamin,,"@Servas, a quarter down means we can't afford a program that needs a second department to keep it alive.","{""words"":19,""mentions"":[""Servas""],""raw_differs"":false}"
43,2,2,talk,Yumi,,"@Benjamin, that makes sense. I saw the midwifery rota has slack, so maybe we can use that.","{""words"":17,""mentions"":[""Benjamin""],""raw_differs"":false}"
44,2,2,talk,Servas,,"@Benjamin, I agree. We need something that stands on its own, not something that needs a partner to survive.","{""words"":19,""mentions"":[""Benjamin""],""raw_differs"":false}"
45,2,3,talk,Asuka,,"The call-back trial worked, but it required active management. We need a program that sustains itself.","{""words"":16,""mentions"":[],""raw_differs"":false}"
46,2,3,talk,Toshio,,"The car park fills before eleven, and the shuttle misses most villages. A new program needs to fit the existing flow.","{""words"":21,""mentions"":[],""raw_differs"":false}"
47,2,3,talk,Benjamin,,The data agreements take fourteen months to sign. Any program relying on outside data is a year behind before it starts.,"{""words"":21,""mentions"":[],""raw_differs"":false}"
48,2,3,talk,Yumi,,"The agency cover is eating the pay bill, so any new program has to work with the staff we already have.","{""words"":21,""mentions"":[],""raw_differs"":false}"
49,2,3,talk,Servas,,"The off-site contacts earn nothing, so a program that goes out to the community will not pay for itself.","{""words"":19,""mentions"":[],""raw_differs"":false}"
50,2,4,talk,Asuka,,We need a program that works within the existing booking system and does not rely on outside partners.,"{""words"":18,""mentions"":[],""raw_differs"":false}"
51,2,4,talk,Toshio,,"It has to fit the rooms and the parking. If it needs more space, it will seize up the whole day.","{""words"":21,""mentions"":[],""raw_differs"":false}"
52,2,4,talk,Benjamin,,"It has to be owned by one department, with no shared rota and no outside data dependency.","{""words"":17,""mentions"":[],""raw_differs"":false}"
53,2,4,talk,Yumi,,It has to use the midwifery slack and not add to the agency cover. That is the only way it will last.,"{""words"":22,""mentions"":[],""raw_differs"":false}"
54,2,4,talk,Servas,,"It has to be on-site, self-funding, and owned by one team. That is the only way it will not vanish in a year.","{""words"":23,""mentions"":[],""raw_differs"":false}"
