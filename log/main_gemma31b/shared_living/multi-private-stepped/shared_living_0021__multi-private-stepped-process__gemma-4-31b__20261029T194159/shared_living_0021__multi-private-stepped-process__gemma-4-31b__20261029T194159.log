30,2,,status,Misaki,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
31,2,,status,Minato,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
32,2,,status,Shion,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
