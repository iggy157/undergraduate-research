46,3,,status,Servas,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
47,3,,status,Mizuki,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
