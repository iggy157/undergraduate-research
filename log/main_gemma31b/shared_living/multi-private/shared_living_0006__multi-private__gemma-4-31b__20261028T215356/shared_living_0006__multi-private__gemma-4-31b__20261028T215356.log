34,2,,status,Takumi,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
35,2,,status,Benjamin,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
