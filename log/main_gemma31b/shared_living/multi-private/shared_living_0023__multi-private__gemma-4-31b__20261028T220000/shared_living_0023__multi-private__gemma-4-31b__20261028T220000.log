34,2,,status,Victoria,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
35,2,,status,May,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
