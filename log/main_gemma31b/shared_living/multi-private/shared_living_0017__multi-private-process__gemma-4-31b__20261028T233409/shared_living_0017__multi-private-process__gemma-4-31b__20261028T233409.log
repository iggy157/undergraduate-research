30,2,,status,Ryuji,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
31,2,,status,Mio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
