24,1,4,talk,Rin,,I'm excited to see what I find!,"{""words"":7,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over""}]}"
25,1,4,pass,Rin,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
26,1,4,talk,Servas,,I look forward to our shared discovery.,"{""words"":7,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
27,1,4,pass,Servas,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
28,1,4,talk,Toshio,,I believe the facts will speak for themselves.,"{""words"":8,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over""}]}"
