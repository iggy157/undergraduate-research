35,2,,status,Toshio,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
36,2,,status,Rin,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
