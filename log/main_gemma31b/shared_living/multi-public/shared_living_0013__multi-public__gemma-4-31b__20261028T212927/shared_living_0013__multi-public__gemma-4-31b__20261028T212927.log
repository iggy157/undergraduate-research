31,2,,status,Daisuke,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
32,2,,status,Mio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
