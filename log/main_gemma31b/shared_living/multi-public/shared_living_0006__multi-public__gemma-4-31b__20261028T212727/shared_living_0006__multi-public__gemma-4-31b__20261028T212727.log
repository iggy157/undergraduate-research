67,3,2,talk,Benjamin,,"I concur. It is rare that we find such immediate and total agreement, but the data left us little room for doubt. I am satisfied with this outcome.","{""words"":28,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over""}]}"
68,3,2,pass,Benjamin,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
69,3,2,talk,Jonathan,,"I agree. While the disparity in usage persists, the collective stability of the club must come first. I am content with this decision.","{""words"":23,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over""}]}"
