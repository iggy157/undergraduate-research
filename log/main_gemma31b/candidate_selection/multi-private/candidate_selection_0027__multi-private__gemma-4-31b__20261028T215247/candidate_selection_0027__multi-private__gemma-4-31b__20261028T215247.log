30,2,,status,Daisuke,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
31,2,,status,Toshio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
