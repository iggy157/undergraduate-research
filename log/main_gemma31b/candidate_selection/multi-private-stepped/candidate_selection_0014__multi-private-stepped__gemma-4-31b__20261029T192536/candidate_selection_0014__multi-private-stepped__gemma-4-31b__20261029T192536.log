2,1,,status,Benjamin,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
3,1,,status,Minako,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
