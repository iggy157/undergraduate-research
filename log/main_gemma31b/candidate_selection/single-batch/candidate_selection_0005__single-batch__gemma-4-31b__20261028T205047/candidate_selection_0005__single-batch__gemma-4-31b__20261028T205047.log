58,3,,status,Daisuke,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
59,3,,status,Shion,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
60,3,1,talk,Yumi,,"The candidates are a Maker Workshop, Digital Archive, Language Circles, or a Mobile Branch. I love the Mobile Branch!","{""words"":19,""mentions"":[],""raw_differs"":false}"
61,3,1,talk,Benjamin,,The Digital Archive is the most rational choice. We can finally finish what was started six years ago.,"{""words"":18,""mentions"":[],""raw_differs"":false}"
62,3,1,talk,Shion,,I vote for the Digital Archive. It's the only one that doesn't create a staffing nightmare.,"{""words"":16,""mentions"":[],""raw_differs"":false}"
63,3,1,talk,Minako,,The Mobile Branch is too risky financially given last year's overruns. I prefer the Digital Archive.,"{""words"":16,""mentions"":[],""raw_differs"":false}"
64,3,1,talk,Daisuke,,"I want the Mobile Branch... but if the roads and buses are this bad, maybe the Archive helps them from home?","{""words"":21,""mentions"":[],""raw_differs"":false}"
65,3,2,talk,Yumi,,"@Daisuke, do you think the Archive is enough for them?","{""words"":10,""mentions"":[""Daisuke""],""raw_differs"":false}"
66,3,2,talk,Benjamin,,It provides access to records and information without the hour-long commute.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
67,3,2,talk,Shion,,It's better than a workshop we can't supervise or a van that breaks the budget.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
68,3,2,talk,Minako,,It is the most stable option for the long term.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
69,3,2,talk,Daisuke,,"I suppose... if they can use it from home, it helps.","{""words"":11,""mentions"":[],""raw_differs"":false}"
70,3,3,talk,Yumi,,"I still feel for the people, but I don't want the program to fail. I'll go with the Archive.","{""words"":19,""mentions"":[],""raw_differs"":false}"
71,3,3,talk,Benjamin,,"A wise concession, Yumi.","{""words"":4,""mentions"":[""Yumi""],""raw_differs"":false}"
72,3,3,talk,Shion,,We are in agreement then.,"{""words"":5,""mentions"":[],""raw_differs"":false}"
73,3,3,talk,Minako,,It seems the most pragmatic path.,"{""words"":6,""mentions"":[],""raw_differs"":false}"
74,3,3,talk,Daisuke,,I'll vote for the Archive too.,"{""words"":6,""mentions"":[],""raw_differs"":false}"
