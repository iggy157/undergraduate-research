31,2,,status,Shion,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
32,2,,status,May,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
