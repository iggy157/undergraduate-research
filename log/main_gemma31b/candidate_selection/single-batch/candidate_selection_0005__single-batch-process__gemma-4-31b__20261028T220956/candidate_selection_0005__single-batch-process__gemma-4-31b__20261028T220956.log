29,2,,status,Minako,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
30,2,,status,Yumi,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
31,2,,status,Benjamin,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
32,2,,status,Daisuke,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
33,2,,status,Shion,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
34,2,1,talk,Yumi,,"The delivery windows for scanning are unreliable, but tool shipping is fast. Also, roads north of the river close often.","{""words"":20,""mentions"":[],""raw_differs"":false}"
35,2,1,talk,Benjamin,,"Interestingly, a digitisation project failed years ago, but partner-run evening groups are still going strong without our help.","{""words"":18,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Shion,,"We have retired tradespeople for tools, but no one on payroll is trained to supervise outside facilitators.","{""words"":17,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Minako,,"The grants only cover session fees for a year. Also, vehicle running costs overran by a third last year.","{""words"":19,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Daisuke,,"Outer wards lost their bus links. People face hour-long trips now, but old outreach stops were very popular.","{""words"":18,""mentions"":[],""raw_differs"":false}"
39,2,2,talk,Yumi,,"@Minako, if vehicle costs are that high and roads close, a mobile service seems risky.","{""words"":15,""mentions"":[""Minako""],""raw_differs"":false}"
40,2,2,talk,Benjamin,,"@Shion, if we can't supervise facilitators, those ""Language Circles"" might struggle unless they are self-sustaining.","{""words"":15,""mentions"":[""Shion""],""raw_differs"":false}"
41,2,2,talk,Shion,,"Exactly. And the tool certification expert retired, so a Maker Workshop would rely entirely on volunteers.","{""words"":16,""mentions"":[],""raw_differs"":false}"
42,2,2,talk,Minako,,The funding gap in the second year is a real threat. We need something that doesn't bleed the operating budget.,"{""words"":20,""mentions"":[],""raw_differs"":false}"
43,2,2,talk,Daisuke,,But the need in the outer wards is so high. They are completely cut off.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
44,2,3,talk,Yumi,,We need a balance. Something that reaches people but doesn't collapse when a road closes or a grant ends.,"{""words"":19,""mentions"":[],""raw_differs"":false}"
45,2,3,talk,Benjamin,,"The data shows that remote catalogue use peaks late at night, while our rooms are full in the evenings.","{""words"":19,""mentions"":[],""raw_differs"":false}"
46,2,3,talk,Shion,,"A digital portal doesn't need physical supervision, but Benjamin mentioned a previous digitisation attempt failed.","{""words"":15,""mentions"":[""Benjamin""],""raw_differs"":false}"
47,2,3,talk,Minako,,A mobile service is too expensive to maintain long-term given the budget trends I've seen.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
48,2,3,talk,Daisuke,,"If we can't do a mobile branch, how do we help the people in the outer wards?","{""words"":17,""mentions"":[],""raw_differs"":false}"
49,2,4,talk,Yumi,,Maybe the Language Circles? They could happen in the community halls that stay open during winter.,"{""words"":16,""mentions"":[],""raw_differs"":false}"
50,2,4,talk,Benjamin,,Only if they follow the model of those six-year-old groups that survived independently.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
51,2,4,talk,Shion,,But we still have the supervision issue if the library is officially responsible.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
52,2,4,talk,Minako,,We must avoid high-maintenance equipment or volatile vehicle costs.,"{""words"":9,""mentions"":[],""raw_differs"":false}"
53,2,4,talk,Daisuke,,I just want to make sure we don't ignore the people who can't reach us.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
54,3,,status,Minako,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
55,3,,status,Yumi,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
