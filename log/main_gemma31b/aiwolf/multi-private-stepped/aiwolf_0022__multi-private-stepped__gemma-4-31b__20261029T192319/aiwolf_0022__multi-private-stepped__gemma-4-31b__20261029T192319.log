33,1,1,talk,Mizuki,,"@Jonathan, that's a very bold claim for the first turn. Are you the Seer?","{""words"":14,""mentions"":[""Jonathan""],""raw_differs"":false}"
34,1,1,talk,Midori,,"Oh dear, such a strong accusation so early. Are you sure, Jonathan?","{""words"":12,""mentions"":[""Jonathan""],""raw_differs"":false}"
35,1,1,talk,Takumi,,"What?! You're lying! I'm not the werewolf! @Jonathan, why are you framing me?","{""words"":13,""mentions"":[""Jonathan""],""raw_differs"":false}"
