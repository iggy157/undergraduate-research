1,0,,status,Kenji,,ALIVE,"{""seat"":2,""role"":""POSSESSED"",""alive"":true}"
2,0,,status,Benjamin,,ALIVE,"{""seat"":3,""role"":""VILLAGER"",""alive"":true}"
