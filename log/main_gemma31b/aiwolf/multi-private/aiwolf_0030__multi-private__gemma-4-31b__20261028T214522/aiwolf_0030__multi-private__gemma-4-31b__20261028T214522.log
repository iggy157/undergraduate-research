27,1,,status,Ryuji,,ALIVE,"{""seat"":2,""role"":""WEREWOLF"",""alive"":true}"
28,1,,status,Shunichi,,ALIVE,"{""seat"":3,""role"":""POSSESSED"",""alive"":true}"
