23,0,4,talk,Shunichi,,This should be amusing.,"{""words"":4,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
24,0,4,pass,Shunichi,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
25,0,4,talk,Midori,,I'll do my best to keep the peace.,"{""words"":8,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
