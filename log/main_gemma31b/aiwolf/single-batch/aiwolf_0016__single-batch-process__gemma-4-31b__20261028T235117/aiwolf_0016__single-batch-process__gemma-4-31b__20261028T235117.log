55,1,4,talk,Sakura,,I'm voting for Mizuki! I trust Ryuji!,"{""words"":7,""mentions"":[""Mizuki"",""Ryuji""],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
