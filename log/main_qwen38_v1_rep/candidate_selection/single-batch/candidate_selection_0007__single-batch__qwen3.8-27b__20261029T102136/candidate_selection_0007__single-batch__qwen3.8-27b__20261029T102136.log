35,2,1,talk,May,,"The ferry trial worked, but the rail and ferry back offices never agreed on data.","{""words"":15,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Benjamin,,"The late-turn pool is gone. Overtime is covering everything, including maintenance.","{""words"":11,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Midori,,"The audits show waiting for connections is the real time sink, not the machines.","{""words"":14,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Shizue,,The pre-war shells are hiding voids. Bidders are pricing in heavy contingency now.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
39,2,1,talk,Jonathan,,"The capital ledger is ring-fenced, but the operating subsidy was trimmed again.","{""words"":12,""mentions"":[],""raw_differs"":false}"
40,2,2,talk,May,,"@Shizue, does that mean station work is risky?","{""words"":8,""mentions"":[""Shizue""],""raw_differs"":false}"
