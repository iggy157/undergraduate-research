33,2,,status,Jonathan,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
34,2,,status,Minako,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
35,2,1,talk,Shizue,,"The roads north were closed eleven days, but halls kept their timetables.","{""words"":12,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Jonathan,,"The outer wards lost their bus link, making travel an hour round trip.","{""words"":13,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Rin,,"Old outreach stops averaged forty visitors, more than the main building.","{""words"":11,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Benjamin,,"The vehicle line overran by a third, but equipment came in under budget.","{""words"":13,""mentions"":[],""raw_differs"":false}"
39,2,1,talk,Minako,,"We have retired tradespeople, but no one trained to supervise outside facilitators.","{""words"":12,""mentions"":[],""raw_differs"":false}"
40,2,2,talk,Shizue,,"@Jonathan, that bus loss is severe. It isolates those wards completely.","{""words"":11,""mentions"":[""Jonathan""],""raw_differs"":false}"
41,2,2,talk,Jonathan,,"@Shizue, yes. And evening bookings are full, but remote use peaks later.","{""words"":12,""mentions"":[""Shizue""],""raw_differs"":false}"
42,2,2,talk,Rin,,"@Benjamin, if vehicles are expensive, maybe a static room is better?","{""words"":11,""mentions"":[""Benjamin""],""raw_differs"":false}"
43,2,2,talk,Benjamin,,"@Rin, the grant only covers fees for twelve months, then it's flat budget.","{""words"":13,""mentions"":[""Rin""],""raw_differs"":false}"
44,2,2,talk,Minako,,"@Rin, the tool certification lapsed when the technician retired.","{""words"":9,""mentions"":[""Rin""],""raw_differs"":false}"
45,2,3,talk,Shizue,,The community halls proved they can operate independently of our roads.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
46,2,3,talk,Jonathan,,"We need to consider where people actually are, not just where we are.","{""words"":13,""mentions"":[],""raw_differs"":false}"
47,2,3,talk,Rin,,"The old digitisation project failed, but the evening groups still meet.","{""words"":11,""mentions"":[],""raw_differs"":false}"
48,2,3,talk,Benjamin,,"So the endowment covers capital, but the grant is short-term.","{""words"":10,""mentions"":[],""raw_differs"":false}"
49,2,3,talk,Minako,,"We have the people, but we lack the supervision structure for new partners.","{""words"":13,""mentions"":[],""raw_differs"":false}"
50,2,4,talk,Shizue,,I feel a mobile service might struggle with the road closures.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
51,2,4,talk,Jonathan,,A fixed location in the outer wards might be better than a van.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
52,2,4,talk,Rin,,"The attendance data suggests people want to come to us, if we are there.","{""words"":14,""mentions"":[],""raw_differs"":false}"
53,2,4,talk,Benjamin,,We must be careful not to promise what the grant cannot sustain.,"{""words"":12,""mentions"":[],""raw_differs"":false}"
54,2,4,talk,Minako,,We need a plan for training supervisors before we start any new program.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
