0,0,,status,Benjamin,,ALIVE,"{""seat"":1,""role"":""POSSESSED"",""alive"":true}"
1,0,,status,Rin,,ALIVE,"{""seat"":2,""role"":""VILLAGER"",""alive"":true}"
