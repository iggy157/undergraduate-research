60,3,1,talk,Daisuke,,Option A is local. No heavy stonework. The bay is safe.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
61,3,1,talk,Toshio,,Option A has craftspeople present. The slips say that is what they want.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
62,3,1,talk,Rin,,Option A uses local craftspeople. The volunteers can help with the interviews.,"{""words"":12,""mentions"":[],""raw_differs"":false}"
63,3,1,talk,Kenji,,Option A avoids the shipping cut-offs. No distant lenders.,"{""words"":9,""mentions"":[],""raw_differs"":false}"
64,3,1,talk,Benjamin,,Option A avoids the bespoke mounts. The tools are already here.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
65,3,2,talk,Daisuke,,"@Kenji, Option B needs loans. The paperwork will slip again.","{""words"":10,""mentions"":[""Kenji""],""raw_differs"":false}"
66,3,2,talk,Toshio,,"@Daisuke, Option B is static. The slips say static rooms lose visitors.","{""words"":12,""mentions"":[""Daisuke""],""raw_differs"":false}"
67,3,2,talk,Rin,,"@Toshio, Option C needs the conservation bench. The lab is empty.","{""words"":11,""mentions"":[""Toshio""],""raw_differs"":false}"
68,3,2,talk,Kenji,,"@Rin, Option C is risky. The finds are fragile.","{""words"":9,""mentions"":[""Rin""],""raw_differs"":false}"
69,3,2,talk,Benjamin,,"@Kenji, Option D needs powered displays. The maintenance log is full.","{""words"":11,""mentions"":[""Kenji""],""raw_differs"":false}"
70,3,3,talk,Daisuke,,"@Benjamin, Option D is a no-go. The bay cannot handle the rigging.","{""words"":12,""mentions"":[""Benjamin""],""raw_differs"":false}"
71,3,3,talk,Toshio,,"@Daisuke, agreed. Option A is the only one that brings people back.","{""words"":12,""mentions"":[""Daisuke""],""raw_differs"":false}"
72,3,3,talk,Rin,,"@Toshio, Option A is the only one we can staff. I vote for A.","{""words"":14,""mentions"":[""Toshio""],""raw_differs"":false}"
73,3,3,talk,Kenji,,"@Rin, Option A is the safest. No shipping, no delays. I vote for A.","{""words"":14,""mentions"":[""Rin""],""raw_differs"":false}"
74,3,3,talk,Benjamin,,"@Kenji, Option A is the cheapest. No mounts, no transport. I vote for A.","{""words"":14,""mentions"":[""Kenji""],""raw_differs"":false}"
75,3,4,talk,Daisuke,,"@Benjamin, Option A respects the building. I vote for A.","{""words"":10,""mentions"":[""Benjamin""],""raw_differs"":false}"
76,3,4,talk,Toshio,,"@Daisuke, Option A respects the record. I vote for A.","{""words"":10,""mentions"":[""Daisuke""],""raw_differs"":false}"
77,3,4,talk,Rin,,"@Toshio, Option A respects the staff. I vote for A.","{""words"":10,""mentions"":[""Toshio""],""raw_differs"":false}"
78,3,4,talk,Kenji,,"@Rin, Option A respects the timeline. I vote for A.","{""words"":10,""mentions"":[""Rin""],""raw_differs"":false}"
79,3,4,talk,Benjamin,,"@Kenji, Option A respects the budget. I vote for A.","{""words"":10,""mentions"":[""Kenji""],""raw_differs"":false}"
