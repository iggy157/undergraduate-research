31,2,,status,Toshio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
32,2,,status,Daisuke,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
33,2,,status,Sakura,,ALIVE,"{""seat"":4,""role"":""PARTICIPANT"",""alive"":true}"
34,2,,status,Midori,,ALIVE,"{""seat"":5,""role"":""PARTICIPANT"",""alive"":true}"
35,2,1,talk,Sakura,,"The offshore house is 5,400 yen a head. Last time, separate rooms varied by 8,000 yen.","{""words"":16,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Victoria,,"The valley inn is 17,000 yen all-in. City beds are 12,000 to 20,000 plus meals.","{""words"":15,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Midori,,"Last year, two of us didn't meet all day. In the shared house, there was no privacy.","{""words"":17,""mentions"":[],""raw_differs"":false}"
38,2,1,talk,Toshio,,The ferry takes two days total. The train to the spa is only ninety minutes.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
39,2,1,talk,Daisuke,,"The inn baths are open until midnight. But dinner is at six, and we share one room.","{""words"":17,""mentions"":[],""raw_differs"":false}"
40,2,2,talk,Sakura,,"@Victoria, 17,000 yen all-in is predictable. I like that. No hidden meal costs.","{""words"":13,""mentions"":[""Victoria""],""raw_differs"":false}"
41,2,2,talk,Victoria,,"@Sakura, yes. But the city option is cheaper if we eat lightly. I need to decide.","{""words"":16,""mentions"":[""Sakura""],""raw_differs"":false}"
42,2,2,talk,Midori,,"@Toshio, ninety minutes is much better than two days. I want to be with you all.","{""words"":16,""mentions"":[""Toshio""],""raw_differs"":false}"
43,2,2,talk,Toshio,,"@Midori, the city has trains every few minutes. The spa town bus stops early.","{""words"":14,""mentions"":[""Midori""],""raw_differs"":false}"
44,2,2,talk,Daisuke,,"@Sakura, if we share one room, I can't sleep. I need a door.","{""words"":13,""mentions"":[""Sakura""],""raw_differs"":false}"
45,2,3,talk,Sakura,,"@Daisuke, the city has separate rooms. You get a door. But the cost varies.","{""words"":14,""mentions"":[""Daisuke""],""raw_differs"":false}"
46,2,3,talk,Victoria,,"@Daisuke, the spa inn has futons in one room. That might be hard for you.","{""words"":15,""mentions"":[""Daisuke""],""raw_differs"":false}"
47,2,3,talk,Midori,,"@Victoria, I worry about the city. We might drift apart again.","{""words"":11,""mentions"":[""Victoria""],""raw_differs"":false}"
48,2,3,talk,Toshio,,"@Midori, the island is one house. We are together, but the travel is long.","{""words"":14,""mentions"":[""Midori""],""raw_differs"":false}"
49,2,3,talk,Daisuke,,"@Toshio, the island has one bathroom for everyone. That is stressful for me.","{""words"":13,""mentions"":[""Toshio""],""raw_differs"":false}"
50,2,4,talk,Sakura,,"I think the city is fair for money, but the spa is better for us.","{""words"":15,""mentions"":[],""raw_differs"":false}"
51,2,4,talk,Victoria,,I prefer the spa. The cost is fixed. I don't want to track meals.,"{""words"":14,""mentions"":[],""raw_differs"":false}"
52,2,4,talk,Midori,,"I want the spa. We are together, and the travel is short.","{""words"":12,""mentions"":[],""raw_differs"":false}"
53,2,4,talk,Toshio,,The spa is efficient. The city is flexible but we might not see each other.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
54,2,4,talk,Daisuke,,I am scared of the shared room. But the city feels too alone.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
