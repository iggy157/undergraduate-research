17,1,3,talk,Victoria,,I will look at the state of the car at handover.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
18,1,3,talk,Misaki,,"I will check last year's tax, insurance and parking papers.","{""words"":10,""mentions"":[],""raw_differs"":false}"
19,1,3,talk,Minato,,I will look at last year's fuel receipts.,"{""words"":8,""mentions"":[],""raw_differs"":false}"
20,1,4,talk,George,,"Also, I will check the spell of checking each other's figures.","{""words"":11,""mentions"":[],""raw_differs"":false}"
21,1,4,talk,Toshio,,And I will look at the month's trial of recording every run.,"{""words"":12,""mentions"":[],""raw_differs"":false}"
22,1,4,talk,Victoria,,I will also check the trips that repeat weekly.,"{""words"":9,""mentions"":[],""raw_differs"":false}"
