60,3,1,talk,Mizuki,,Option A is the inn. Option B is the island. Option C is the city.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
61,3,1,talk,Shizue,,Option B has one bill. That solves my worry about fairness.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
62,3,1,talk,Minato,,Option A has a strict schedule. Option B has one bathroom.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
63,3,1,talk,Jonathan,,Option C is too much alone time. Option B is two days travel.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
64,3,1,talk,Midori,,"Option A is 17,000 yen. Option B is 5,400 yen. Option C is variable.","{""words"":14,""mentions"":[],""raw_differs"":false}"
65,3,2,talk,Mizuki,,"@Minato, can you handle the island bathroom? It is the main risk.","{""words"":12,""mentions"":[""Minato""],""raw_differs"":false}"
66,3,2,talk,Shizue,,"@Mizuki, I think the shared house is worth it for the bonding.","{""words"":12,""mentions"":[""Mizuki""],""raw_differs"":false}"
67,3,2,talk,Minato,,"@Mizuki, I am worried, but I want to be with you all.","{""words"":12,""mentions"":[""Mizuki""],""raw_differs"":false}"
68,3,2,talk,Jonathan,,"@Shizue, the ferry is long, but the island is quiet. I like that.","{""words"":13,""mentions"":[""Shizue""],""raw_differs"":false}"
69,3,2,talk,Midori,,"@Jonathan, the cost difference is huge. The island is much cheaper.","{""words"":11,""mentions"":[""Jonathan""],""raw_differs"":false}"
