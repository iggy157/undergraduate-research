71,3,3,talk,Shizue,,Option B is the only one where the money is clear.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
72,3,3,talk,Minato,,Option A is too strict. Option C is too lonely. Option B is a compromise.,"{""words"":15,""mentions"":[],""raw_differs"":false}"
73,3,3,talk,Jonathan,,"Option B is the best for peace, despite the travel.","{""words"":10,""mentions"":[],""raw_differs"":false}"
74,3,3,talk,Midori,,Option B is the most affordable and keeps us in one place.,"{""words"":12,""mentions"":[],""raw_differs"":false}"
75,3,4,talk,Mizuki,,I am voting for B.,"{""words"":5,""mentions"":[],""raw_differs"":false}"
76,3,4,talk,Shizue,,I am voting for B.,"{""words"":5,""mentions"":[],""raw_differs"":false}"
77,3,4,talk,Minato,,"I am voting for B, reluctantly.","{""words"":6,""mentions"":[],""raw_differs"":false}"
