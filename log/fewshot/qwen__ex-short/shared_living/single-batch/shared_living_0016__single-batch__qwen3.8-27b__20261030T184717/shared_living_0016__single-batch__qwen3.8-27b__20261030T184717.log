68,3,2,talk,May,,"@Minako, I agree. We want to feel like we belong, not like we are ranked.","{""words"":15,""mentions"":[""Minako""],""raw_differs"":false}"
69,3,2,talk,Shunichi,,"@May, but the current system is invisible, not fair.","{""words"":9,""mentions"":[""May""],""raw_differs"":false}"
70,3,3,talk,Minato,,"I am leaning towards A, but I need to know if the fee is high enough.","{""words"":16,""mentions"":[],""raw_differs"":false}"
71,3,3,talk,Ryuji,,"I am leaning towards A, because the fixed costs are the main issue.","{""words"":13,""mentions"":[],""raw_differs"":false}"
72,3,3,talk,Minako,,"I am leaning towards C, but I am worried about the social impact.","{""words"":13,""mentions"":[],""raw_differs"":false}"
