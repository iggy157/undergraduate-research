48,2,3,talk,Misaki,,"@Minato, that sounds exhausting. I prefer the coastal lodge.","{""words"":9,""mentions"":[""Minato""],""raw_differs"":false}"
49,2,3,talk,Takumi,,"@Misaki, the coastal lodge has non-refundable deposits for dropouts.","{""words"":9,""mentions"":[""Misaki""],""raw_differs"":false}"
50,2,4,talk,Asuka,,"@Misaki, that's a risk, but the transport cost is lower.","{""words"":10,""mentions"":[""Misaki""],""raw_differs"":false}"
51,2,4,talk,Shion,,"@Asuka, I worry about the dropouts, but I want us to bond.","{""words"":12,""mentions"":[""Asuka""],""raw_differs"":false}"
