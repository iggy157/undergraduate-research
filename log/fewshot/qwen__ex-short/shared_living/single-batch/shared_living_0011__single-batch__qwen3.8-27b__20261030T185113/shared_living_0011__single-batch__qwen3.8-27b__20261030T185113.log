47,2,3,talk,Minako,,"@Asuka, so the campus option is split into early and late slots?","{""words"":12,""mentions"":[""Asuka""],""raw_differs"":false}"
48,2,3,talk,Jonathan,,"@Minako, that sounds exhausting. I prefer the coastal lodge.","{""words"":9,""mentions"":[""Minako""],""raw_differs"":false}"
49,2,3,talk,Asuka,,"@Jonathan, the coastal lodge has non-refundable deposits for dropouts.","{""words"":9,""mentions"":[""Jonathan""],""raw_differs"":false}"
50,2,4,talk,Ryuji,,"@Asuka, that's a risk, but the transport cost is lower.","{""words"":10,""mentions"":[""Asuka""],""raw_differs"":false}"
51,2,4,talk,Toshio,,"@Ryuji, I worry about the dropouts, but I want us to bond.","{""words"":12,""mentions"":[""Ryuji""],""raw_differs"":false}"
52,2,4,talk,Minako,,"@Toshio, the public center is too rigid with the lottery.","{""words"":10,""mentions"":[""Toshio""],""raw_differs"":false}"
53,2,4,talk,Jonathan,,"@Minako, I agree, the coastal lodge feels more open.","{""words"":9,""mentions"":[""Minako""],""raw_differs"":false}"
54,2,4,talk,Asuka,,"@Jonathan, I need to see the final numbers before I agree.","{""words"":11,""mentions"":[""Jonathan""],""raw_differs"":false}"
