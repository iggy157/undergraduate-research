41,2,2,talk,Toshio,,"@Minako, that explains why the organizers were so tired.","{""words"":9,""mentions"":[""Minako""],""raw_differs"":false}"
42,2,2,talk,Minako,,"@Ryuji, yes, and the application for public centers is a nightmare.","{""words"":11,""mentions"":[""Ryuji""],""raw_differs"":false}"
43,2,2,talk,Jonathan,,"@Asuka, is the campus option better for sleep?","{""words"":8,""mentions"":[""Asuka""],""raw_differs"":false}"
