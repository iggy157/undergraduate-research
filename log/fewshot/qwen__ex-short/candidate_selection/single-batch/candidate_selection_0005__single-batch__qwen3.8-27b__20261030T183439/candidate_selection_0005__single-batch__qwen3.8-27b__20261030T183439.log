60,3,1,talk,Yumi,,"Candidate D, the Mobile Branch, visits outlying neighborhoods on a fixed schedule.","{""words"":12,""mentions"":[],""raw_differs"":false}"
61,3,1,talk,Benjamin,,"Candidate B, the Digital Archive, scans local records for a searchable portal.","{""words"":12,""mentions"":[],""raw_differs"":false}"
62,3,1,talk,Shion,,"Candidate A, the Maker Workshop, offers tools and instruction in the main branch.","{""words"":13,""mentions"":[],""raw_differs"":false}"
63,3,1,talk,Minako,,"Candidate C, the Language Circles, uses trained facilitators and partner organizations.","{""words"":11,""mentions"":[],""raw_differs"":false}"
64,3,1,talk,Daisuke,,I am concerned about the bus links for the mobile service.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
65,3,2,talk,Yumi,,"@Daisuke, the mobile service helps those without bus links, but the vehicle is risky.","{""words"":14,""mentions"":[""Daisuke""],""raw_differs"":false}"
66,3,2,talk,Benjamin,,"@Shion, correct. The past digitisation failed, but a new portal might work.","{""words"":12,""mentions"":[""Shion""],""raw_differs"":false}"
67,3,2,talk,Shion,,"@Benjamin, the digital archive avoids the staffing issues I found.","{""words"":10,""mentions"":[""Benjamin""],""raw_differs"":false}"
68,3,2,talk,Minako,,"The language circles rely on partners, which Benjamin said are more stable.","{""words"":12,""mentions"":[""Benjamin""],""raw_differs"":false}"
69,3,2,talk,Daisuke,,"@Yumi, yes. The running costs overran last year. It is a financial risk.","{""words"":13,""mentions"":[""Yumi""],""raw_differs"":false}"
70,3,3,talk,Yumi,,"The mobile service addresses the access gap, but the vehicle is a liability.","{""words"":13,""mentions"":[],""raw_differs"":false}"
71,3,3,talk,Benjamin,,"The digital archive is a repeat of a failed project, but with better tools.","{""words"":14,""mentions"":[],""raw_differs"":false}"
72,3,3,talk,Shion,,"The maker workshop needs certified technicians, who are no longer on the roster.","{""words"":13,""mentions"":[],""raw_differs"":false}"
73,3,3,talk,Minako,,The language circles have a funding cliff after twelve months.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
74,3,3,talk,Daisuke,,The mobile service is the only one that reaches the outer wards directly.,"{""words"":13,""mentions"":[],""raw_differs"":false}"
75,3,4,talk,Yumi,,"I am leaning towards the mobile service, despite the risks.","{""words"":10,""mentions"":[],""raw_differs"":false}"
76,3,4,talk,Benjamin,,I am worried about the digital archive repeating past mistakes.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
77,3,4,talk,Shion,,The maker workshop is a no-go due to the staffing gap.,"{""words"":11,""mentions"":[],""raw_differs"":false}"
78,3,4,talk,Minako,,The language circles are risky due to the funding structure.,"{""words"":10,""mentions"":[],""raw_differs"":false}"
79,3,4,talk,Daisuke,,"The mobile service is the best for access, but I am concerned about the costs.","{""words"":15,""mentions"":[],""raw_differs"":false}"
