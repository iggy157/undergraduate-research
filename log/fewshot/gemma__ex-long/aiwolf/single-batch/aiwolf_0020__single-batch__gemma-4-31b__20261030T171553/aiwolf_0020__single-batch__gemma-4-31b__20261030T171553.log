22,0,4,talk,Shion,,I have established my position. I will spend the night analyzing your responses.,"{""words"":13,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
23,0,4,pass,Shion,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
24,0,4,talk,Shunichi,,I'm satisfied with this opening. Let's see what the night brings.,"{""words"":11,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
25,0,4,pass,Shunichi,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
