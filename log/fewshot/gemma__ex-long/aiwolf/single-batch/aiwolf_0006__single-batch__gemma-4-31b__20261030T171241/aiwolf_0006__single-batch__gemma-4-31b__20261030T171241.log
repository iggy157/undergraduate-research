23,0,4,pass,Minato,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
24,0,4,talk,Takumi,,I'm not letting my guard down. See you all tomorrow.,"{""words"":10,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over""}]}"
