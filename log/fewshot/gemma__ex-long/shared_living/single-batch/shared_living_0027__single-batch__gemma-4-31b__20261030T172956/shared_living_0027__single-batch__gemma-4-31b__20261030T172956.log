50,3,,status,Shunichi,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
51,3,,status,Toshio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
