34,2,,status,George,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
35,2,,status,Ryuji,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
