35,2,,status,George,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
36,2,,status,Jonathan,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
