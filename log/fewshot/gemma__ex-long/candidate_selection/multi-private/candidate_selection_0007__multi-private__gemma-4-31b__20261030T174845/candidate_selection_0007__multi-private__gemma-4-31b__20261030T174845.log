25,2,,status,Jonathan,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
26,2,,status,Shizue,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
27,2,,status,May,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
