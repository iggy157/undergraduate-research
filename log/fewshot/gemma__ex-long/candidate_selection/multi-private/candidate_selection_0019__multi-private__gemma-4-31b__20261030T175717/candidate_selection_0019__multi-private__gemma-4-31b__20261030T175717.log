35,2,,status,Mio,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
36,2,,status,Shizue,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
