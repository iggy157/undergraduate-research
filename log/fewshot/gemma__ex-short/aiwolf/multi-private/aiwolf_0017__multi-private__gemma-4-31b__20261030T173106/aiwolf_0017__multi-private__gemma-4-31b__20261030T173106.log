23,0,4,talk,May,,"Over! Sweet dreams, everyone. I hope the Seer has some juicy secrets for us tomorrow morning. I'll be waiting!","{""words"":19,""mentions"":[],""raw_differs"":false}"
24,0,4,talk,Jonathan,,I wish you all a peaceful night. I shall reflect on our words and hope for a clear path forward tomorrow.,"{""words"":21,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over.""}]}"
25,0,4,pass,Jonathan,,Over,"{""forced"":false,""empty"":false,""trailing"":true}"
26,0,4,talk,Sakura,,Goodnight everyone! I'm going to dream about catching the werewolf with a giant net! Hehe! See you all tomorrow morning!,"{""words"":20,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over!""}]}"
