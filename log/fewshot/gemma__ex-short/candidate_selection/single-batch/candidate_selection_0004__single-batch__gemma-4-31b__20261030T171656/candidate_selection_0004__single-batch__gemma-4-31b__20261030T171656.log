45,3,,status,Jonathan,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
46,3,,status,Kenji,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
47,3,,status,Minako,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
