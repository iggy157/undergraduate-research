20,2,,status,Daisuke,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
21,2,,status,Toshio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
