20,2,,status,Mizuki,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
21,2,,status,Asuka,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
