27,2,,status,Jonathan,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
28,2,,status,Shizue,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
