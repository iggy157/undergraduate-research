27,2,,status,Sakura,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
28,2,,status,Shion,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
