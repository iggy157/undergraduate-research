26,2,,status,Benjamin,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
27,2,,status,Jonathan,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
28,2,,status,Servas,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
