26,2,,status,Toshio,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
27,2,,status,Jonathan,,ALIVE,"{""seat"":3,""role"":""PARTICIPANT"",""alive"":true}"
