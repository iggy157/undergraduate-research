35,2,,status,Shion,,ALIVE,"{""seat"":1,""role"":""PARTICIPANT"",""alive"":true}"
36,2,,status,Daisuke,,ALIVE,"{""seat"":2,""role"":""PARTICIPANT"",""alive"":true}"
