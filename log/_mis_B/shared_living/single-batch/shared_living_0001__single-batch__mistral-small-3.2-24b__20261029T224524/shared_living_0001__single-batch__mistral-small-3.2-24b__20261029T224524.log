33,2,1,talk,Mio,,"The transport costs are significant, and whole-building lets have strict cancellation policies.","{""words"":12,""mentions"":[],""raw_differs"":false}"
34,2,1,talk,Shizue,,"The seniors say that year-groups mix best when they share accommodation, and a fifth of the membership never came to the last away camp.","{""words"":24,""mentions"":[],""raw_differs"":false}"
35,2,1,talk,Ryuji,,"The club's own hall is already booked, and the public booking lottery is complex.","{""words"":14,""mentions"":[],""raw_differs"":false}"
36,2,1,talk,Rin,,"The inland centres had cramped dormitories, and a third of the club can't be on campus by nine without a bed.","{""words"":21,""mentions"":[],""raw_differs"":false}"
37,2,1,talk,Misaki,,"Public beds are cheap, but cooking for ourselves adds to the workload.","{""words"":12,""mentions"":[],""raw_differs"":false}"
38,2,2,talk,Mio,,"@Ryuji, is there any flexibility in the public booking dates?","{""words"":10,""mentions"":[""Ryuji""],""raw_differs"":false}"
39,2,2,talk,Shizue,,"@Rin, do you think the seaside option would be better for mixing year-groups?","{""words"":13,""mentions"":[""Rin""],""raw_differs"":false}"
40,2,2,talk,Ryuji,,"No, the dates are fixed, and any change requires resubmitting the whole application.","{""words"":13,""mentions"":[],""raw_differs"":false}"
41,2,2,talk,Rin,,"Yes, sharing a building might help, but we need to consider the travel costs.","{""words"":14,""mentions"":[],""raw_differs"":false}"
