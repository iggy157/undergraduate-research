26,0,4,talk,Jonathan,,May the night be peaceful for us all. I shall spend my time in quiet reflection. Until tomorrow.,"{""words"":18,""mentions"":[],""raw_differs"":true,""norm"":[{""code"":""trailing_over"",""token"":""Over"",""tail"":""Over""}]}"
